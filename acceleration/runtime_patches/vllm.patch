+def _mindpipe_calibrate_comm_quant_scales(
+        layer: nn.Module, quantized_x: torch.Tensor,
+        pertoken_scale: torch.Tensor, output_dtype: torch.dtype
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+    """Calibrate shared MC2 communication scales once per o_proj layer.
+
+    Calibration follows the A2 kernel contract: scale 1 quantizes each local
+    matmul result, then scale 2 covers the reduced INT8 partial sum.  The
+    result is cached on the layer, so the measured request path only reuses
+    the two static tensors.
+    """
+    cached = (getattr(layer, "_mindpipe_comm_quant_scale_1", None),
+              getattr(layer, "_mindpipe_comm_quant_scale_2", None))
+    if cached[0] is not None and cached[1] is not None:
+        return cached
+    if pertoken_scale.dim() > 1:
+        pertoken_scale = pertoken_scale.flatten()
+    local_output = _mindpipe_torch_npu.npu_quant_matmul(
+        quantized_x,
+        layer.weight,
+        layer.weight_scale_fp32,
+        pertoken_scale=pertoken_scale,
+        output_dtype=output_dtype,
+    ).float()
+    # The scale tensors must be identical on every TP rank.
+    tp_group = get_tp_group().device_group
+    tp_src = torch.distributed.get_global_rank(tp_group, 0)
+    local_amax = local_output.abs().amax(dim=0)
+    torch.distributed.all_reduce(
+        local_amax, op=torch.distributed.ReduceOp.MAX, group=tp_group)
+    scale1 = (
+        local_amax * _mindpipe_comm_quant_headroom(
+            "MINDPIPE_QWEN2_ATTN_COMM_SCALE1_HEADROOM", 1.02)
+        / 127.0
+    ).clamp_min(torch.finfo(torch.float16).tiny).to(torch.float16)
+    torch.distributed.broadcast(scale1, src=tp_src, group=tp_group)
+    q_local = torch.round(local_output / scale1.float()).clamp(-128, 127)
+    torch.distributed.all_reduce(
+        q_local, op=torch.distributed.ReduceOp.SUM, group=tp_group)
+    qsum_amax = q_local.abs().amax(dim=0)
+    # Quantized partial sums are reduced across TP ranks; derive a shared
+    # scale from the global maximum so every rank uses identical dequantization.
+    torch.distributed.all_reduce(
+        qsum_amax, op=torch.distributed.ReduceOp.MAX, group=tp_group)
+    scale2 = (
+        qsum_amax * scale1.float()
+        * _mindpipe_comm_quant_headroom(
+            "MINDPIPE_QWEN2_ATTN_COMM_SCALE2_HEADROOM", 1.02)
+        / 127.0
+    ).clamp_min(torch.finfo(torch.float16).tiny).to(torch.float16)
+    torch.distributed.broadcast(scale2, src=tp_src, group=tp_group)
+    layer._mindpipe_comm_quant_scale_1 = scale1
+    layer._mindpipe_comm_quant_scale_2 = scale2
+    return scale1, scale2
+
