+"""Opt-in Qwen2 W8A8 grouped SwiGLU hybrid output bridge."""
+
+from __future__ import annotations
+
+import json
+import os
+import threading
+import time
+from pathlib import Path
+from typing import List, Tuple
+
+import torch
+
+from vllm.utils import direct_register_custom_op
+
+_OP_NAME = "mindpipe_qwen2_grouped_swiglu_loop_out"
+_EXTENSION_NAME = "mindpipe_aclnn_grouped_swiglu_out_v2"
+_LOAD_LOCK = threading.Lock()
+_TRACE_LOCK = threading.Lock()
+_BRIDGE = None
+_TORCH_NPU = None
+_OP = None
+_TRACE_COUNT = 0
+
+
+def _trace_limit() -> int:
+    try:
+        return max(
+            0,
+            int(
+                os.getenv(
+                    "MINDPIPE_QWEN2_MLP_CHUNKED_LOOP_OUT_TRACE_LIMIT",
+                    "200",
+                )),
+        )
+    except ValueError:
+        return 200
+
+
+def _record_hit(
+    x: torch.Tensor,
+    weights: List[torch.Tensor],
+    batched_weight: torch.Tensor,
+    weight_scales: List[torch.Tensor],
+    batched_weight_scale: torch.Tensor,
+    outputs: Tuple[torch.Tensor, torch.Tensor],
+    route: str,
+    min_tokens: int,
+    layer_idx: int,
+) -> None:
+    path_value = os.getenv("MINDPIPE_QWEN2_MLP_CHUNKED_LOOP_OUT_TRACE_PATH",
+                           "").strip()
+    if not path_value:
+        return
+    limit = _trace_limit()
+    if limit == 0:
+        return
+    global _TRACE_COUNT
+    with _TRACE_LOCK:
+        if _TRACE_COUNT >= limit:
+            return
+        _TRACE_COUNT += 1
+        row = {
+            "kind":
+            "qwen2_mlp_chunked_loop_out_hit",
+            "pid":
+            os.getpid(),
+            "hit_index":
+            _TRACE_COUNT,
+            "time":
+            time.time(),
+            "layer_idx":
+            int(layer_idx),
+            "tokens":
+            int(x.shape[0]),
+            "route":
+            route,
+            "min_tokens":
+            int(min_tokens),
+            "chunks":
+            len(weights),
+            "x_shape":
+            list(x.shape),
+            "x_dtype":
+            str(x.dtype),
+            "weight_shapes": [list(weight.shape) for weight in weights],
+            "weight_storage_offsets":
+            [int(weight.storage_offset()) for weight in weights],
+            "batched_weight_shape":
+            list(batched_weight.shape),
+            "batched_weight_storage_offset":
+            int(batched_weight.storage_offset()),
+            "weight_scale_shapes":
+            [list(scale.shape) for scale in weight_scales],
+            "batched_weight_scale_shape":
+            list(batched_weight_scale.shape),
+            "output_shapes": [list(output.shape) for output in outputs],
+            "output_dtypes": [str(output.dtype) for output in outputs],
+            "task_queue_enable":
+            os.getenv("TASK_QUEUE_ENABLE", "1"),
+        }
+        path = Path(path_value)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with path.open("a", encoding="utf-8") as handle:
+            handle.write(json.dumps(row, sort_keys=True) + "\n")
+
+
+def _op_impl(
+    x: torch.Tensor,
+    weights: List[torch.Tensor],
+    batched_weight: torch.Tensor,
+    group_list: torch.Tensor,
+    weight_scales: List[torch.Tensor],
+    batched_weight_scale: torch.Tensor,
+    x_scale: torch.Tensor,
+    min_tokens: int,
+    layer_idx: int,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    if _BRIDGE is None or _TORCH_NPU is None:
+        raise RuntimeError("Qwen2 loop-out bridge was not loaded")
+    token_count = int(x.shape[0])
+    chunks = len(weights)
+    if token_count >= min_tokens:
+        route = "direct"
+        outputs = _BRIDGE.forward(x, weights, group_list, weight_scales,
+                                  x_scale)
+    else:
+        route = "batched_repeat"
+        repeated_x = x.repeat((chunks, 1))
+        repeated_scale = x_scale.repeat(chunks)
+        batched_group_list = (
+            torch.arange(
+                1,
+                chunks + 1,
+                device=x.device,
+                dtype=torch.int64,
+            ) * token_count)
+        quant_output, scale_output, _ = (
+            _TORCH_NPU.npu_grouped_matmul_swiglu_quant(
+                x=repeated_x,
+                weight=batched_weight,
+                group_list=batched_group_list,
+                weight_scale=batched_weight_scale,
+                x_scale=repeated_scale,
+            ))
+        output_width = batched_weight_scale.shape[-1] // 2
+        outputs = (
+            quant_output.reshape(chunks, token_count, output_width),
+            scale_output.reshape(chunks, token_count),
+        )
+    _record_hit(
+        x,
+        weights,
+        batched_weight,
+        weight_scales,
+        batched_weight_scale,
+        outputs,
+        route,
+        min_tokens,
+        layer_idx,
+    )
+    return outputs
+
+
+def _op_fake(
+    x: torch.Tensor,
+    weights: List[torch.Tensor],
+    batched_weight: torch.Tensor,
+    group_list: torch.Tensor,
+    weight_scales: List[torch.Tensor],
+    batched_weight_scale: torch.Tensor,
+    x_scale: torch.Tensor,
+    min_tokens: int,
+    layer_idx: int,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    del group_list, x_scale, min_tokens, layer_idx
+    if not weights or len(weights) != len(weight_scales):
+        raise RuntimeError("loop-out requires equal non-empty weight lists")
+    chunks = len(weights)
+    if batched_weight.shape[0] != chunks:
+        raise RuntimeError("loop-out batched weight has an invalid chunk count")
+    if batched_weight_scale.shape[0] != chunks:
+        raise RuntimeError(
+            "loop-out batched weight scale has an invalid chunk count")
+    gate_up_width = batched_weight_scale.shape[-1]
+    if batched_weight.shape[-1] != gate_up_width:
+        raise RuntimeError("loop-out batched weight and scale widths differ")
+    for weight, scale in zip(weights, weight_scales):
+        if weight.shape[-1] != gate_up_width:
+            raise RuntimeError("loop-out weight view widths differ")
+        if scale.shape[-1] != gate_up_width:
+            raise RuntimeError("loop-out weight scale view widths differ")
+    output_width = gate_up_width // 2
+    quant_output = torch.empty(
+        (chunks, x.shape[0], output_width),
+        dtype=torch.int8,
+        device=x.device,
+    )
+    scale_output = torch.empty((chunks, x.shape[0]),
+                               dtype=torch.float32,
+                               device=x.device)
+    return quant_output, scale_output
+
+
+def _check_runtime_contract() -> None:
+    if os.getenv("TASK_QUEUE_ENABLE", "1") == "2":
+        raise RuntimeError("Qwen2 loop-out requires TASK_QUEUE_ENABLE=0 or 1; "
+                           "NPU graph capture does not support 2")
+    try:
+        from vllm_ascend.ascend_config import get_ascend_config
+    except ImportError:
+        return
+    try:
+        torchair_config = get_ascend_config().torchair_graph_config
+    except RuntimeError as exc:
+        if "Ascend config is not initialized" in str(exc):
+            return
+        raise
+    if bool(getattr(torchair_config, "enabled", False)):
+        raise RuntimeError(
+            "Qwen2 loop-out is registered as a torch.ops.vllm custom op and "
+            "has not passed a TorchAir GE converter gate")
+
+
+def _load_bridge():
+    import torch_npu
+    from torch.utils.cpp_extension import load
+
+    source_value = os.getenv("MINDPIPE_QWEN2_MLP_CHUNKED_LOOP_OUT_SOURCE",
+                             "").strip()
+    if not source_value:
+        raise RuntimeError(
+            "MINDPIPE_QWEN2_MLP_CHUNKED_LOOP_OUT_SOURCE must name the "
+            "audited bridge source")
+    source = Path(source_value).expanduser().resolve()
+    if not source.is_file():
+        raise RuntimeError(f"Qwen2 loop-out bridge source not found: {source}")
+
+    ascend = Path(
+        os.getenv(
+            "ASCEND_HOME_PATH",
+            "/usr/local/Ascend/ascend-toolkit/latest",
+        ))
+    torch_npu_root = Path(torch_npu.__file__).resolve().parent
+    toolchain_value = os.getenv("MINDPIPE_ACLNN_GCC_TOOLCHAIN", "").strip()
+    if not toolchain_value:
+        raise RuntimeError(
+            "MINDPIPE_ACLNN_GCC_TOOLCHAIN must name the GCC 11 "
+            "cross-toolchain bin directory")
+    toolchain = Path(toolchain_value)
+    cc = toolchain / "aarch64-conda-linux-gnu-gcc"
+    cxx = toolchain / "aarch64-conda-linux-gnu-g++"
+    if not cc.is_file() or not cxx.is_file():
+        raise RuntimeError(f"GCC 11 toolchain not found under {toolchain}")
+    os.environ["CC"] = str(cc)
+    os.environ["CXX"] = str(cxx)
+
+    opapi_lib = (ascend /
+                 "opp/built-in/op_impl/ai_core/tbe/op_api/lib/linux/aarch64")
+    return load(
+        name=_EXTENSION_NAME,
+        sources=[str(source)],
+        extra_include_paths=[
+            str(torch_npu_root / "include"),
+            str(ascend / "aarch64-linux/include"),
+            str(ascend / "opp/built-in/op_impl/ai_core/tbe/op_api/include"),
+        ],
+        extra_cflags=["-O3"],
+        extra_ldflags=[
+            f"-L{opapi_lib}",
+            f"-Wl,-rpath,{opapi_lib}",
+            "-lopapi",
+            f"-L{ascend / 'lib64'}",
+            f"-Wl,-rpath,{ascend / 'lib64'}",
+            "-lnnopbase",
+            f"-L{torch_npu_root / 'lib'}",
+            f"-Wl,-rpath,{torch_npu_root / 'lib'}",
+            "-ltorch_npu",
+        ],
+        verbose=(os.getenv("MINDPIPE_QWEN2_MLP_CHUNKED_LOOP_OUT_BUILD_VERBOSE")
+                 == "1"),
+    )
+
+
+def load_and_register():
+    global _BRIDGE, _OP, _TORCH_NPU
+    with _LOAD_LOCK:
+        if _OP is not None:
+            return _OP
+        _check_runtime_contract()
+        _BRIDGE = _load_bridge()
+        import torch_npu
+        _TORCH_NPU = torch_npu
+        direct_register_custom_op(
+            op_name=_OP_NAME,
+            op_func=_op_impl,
+            fake_impl=_op_fake,
+            dispatch_key="PrivateUse1",
+        )
+        _OP = getattr(torch.ops.vllm, _OP_NAME).default
