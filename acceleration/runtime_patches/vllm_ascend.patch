+
+ENABLE_ENV = "MINDPIPE_MIXTRAL_TP4_MOE_PIPELINE"
+MIN_TOKENS_ENV = "MINDPIPE_MIXTRAL_TP4_MOE_PIPELINE_MIN_TOKENS"
+TRACE_PATH_ENV = "MINDPIPE_MIXTRAL_TP4_MOE_PIPELINE_TRACE_PATH"
+TRACE_LIMIT_ENV = "MINDPIPE_MIXTRAL_TP4_MOE_PIPELINE_TRACE_LIMIT"
+# Diagnostic-only policy override.  The default shape-aware policy remains
+# unchanged; this is used to compare tile4/tile8 at one service shape.
+TILE_COUNT_OVERRIDE_ENV = "MINDPIPE_MIXTRAL_TP4_MOE_PIPELINE_TILE_COUNT_OVERRIDE"
+PENDING_DEPTH_ENV = "MINDPIPE_MIXTRAL_TP4_MOE_PIPELINE_PENDING_DEPTH"
+ROUTING_METADATA_MODE_ENV = "MINDPIPE_MIXTRAL_TP4_ROUTING_METADATA_MODE"
+ALLOW_OPTIMIZED_PROFILE_ENV = "MINDPIPE_MIXTRAL_ALLOW_OPTIMIZED_PROFILE"
+
+DEFAULT_MIN_TOKENS = 16384
+DEFAULT_TRACE_LIMIT = 1
+SMALL_PREFILL_TILE_COUNT = 4
+LARGE_PREFILL_TILE_COUNT = 8
+SMALL_PREFILL_MAX_TOKENS = 45056
+# Preserve the historical constant for large-prefill callers. The runtime
+# carrier selects tile4 or tile8 from the actual prefill shape.
+TILE_COUNT = LARGE_PREFILL_TILE_COUNT
+MAX_PENDING_WORK = 2
+DEFAULT_ROUTING_METADATA_MODE = 1
+ROUTING_METADATA_MODES = (1, 2)
+NUM_EXPERTS = 8
+TOP_K = 2
+HIDDEN_SIZE = 4096
+LOCAL_INTERMEDIATE_SIZE = 3584
+W13_OUTPUT_SIZE = 2 * LOCAL_INTERMEDIATE_SIZE
+TRACE_KIND = "mixtral_tp4_routing_exact_chain_hit"
+TRACE_SCHEMA_VERSION = 1
+
+_TRACE_LOCK = threading.Lock()
+_TRACE_HANDLES: dict[Path, Any] = {}
+_TRACE_COUNTS: dict[Path, int] = {}
+_HIT_LOGGED = False
+
+
+class MixtralTP4RoutingExactChainContractError(RuntimeError):
+    """Raised after an opted-in carrier violates its frozen runtime ABI."""
+
+
+def pending_depth_for_runtime() -> int:
+    """Return the bounded async-collective window selected by the process env."""
+    raw = os.getenv(PENDING_DEPTH_ENV)
+    if raw is None or raw == "":
+        return MAX_PENDING_WORK
+    try:
+        value = int(raw)
+    except ValueError:
+        return MAX_PENDING_WORK
+    return value if 1 <= value <= 4 else MAX_PENDING_WORK
+
+
+def routing_metadata_mode_for_runtime() -> tuple[int, bool]:
+    """Return the selected routing metadata ABI and whether it is valid."""
+    raw = os.getenv(ROUTING_METADATA_MODE_ENV)
+    if raw is None or raw == "":
+        return DEFAULT_ROUTING_METADATA_MODE, True
+    if raw not in {str(mode) for mode in ROUTING_METADATA_MODES}:
+        return DEFAULT_ROUTING_METADATA_MODE, False
+    return int(raw), True
+
+
+def routing_metadata_contract(mode: int) -> dict[str, Any]:
+    if mode == 1:
+        return {
+            "expert_tokens_num_mode": 1,
+            "expert_metadata_semantics": "cumulative_endpoints",
+            "metadata_dtype_adapter": "explicit .to(torch.int64)",
+            "gmm2_group_list_type": 0,
+        }
+    if mode == 2:
+        return {
+            "expert_tokens_num_mode": 2,
+            "expert_metadata_semantics": "raw_count",
+            "metadata_dtype_adapter": (
+                "explicit .to(torch.int64); cumsum for GMM1 only"),
+            "gmm2_group_list_type": 1,
+        }
+    raise ValueError(f"unsupported routing metadata mode: {mode}")
+
+
+@dataclass(frozen=True)
+class MixtralTP4RoutingExactChainResult:
+    hidden_states: torch.Tensor
+    num_tokens: int
+    layer_id: Optional[int]
+    layer_prefix: str
+    tile_count: int
+    collective_count: int
+    tp_sum_completed: bool = True
+    pending_depth: int = MAX_PENDING_WORK
+    routing_metadata_mode: int = DEFAULT_ROUTING_METADATA_MODE
+    expert_metadata_semantics: str = "cumulative_endpoints"
+    gmm2_group_list_type: int = 0
+
+
+def tile_count_for_tokens(num_tokens: int) -> int:
+    override, valid = _tile_count_override()
+    if not valid:
+        # Invalid overrides fail closed through the opt-in guard rather than
+        # silently changing the production policy.
+        return LARGE_PREFILL_TILE_COUNT
+    if override is not None:
+        return override
+    if DEFAULT_MIN_TOKENS <= num_tokens < SMALL_PREFILL_MAX_TOKENS:
+        return SMALL_PREFILL_TILE_COUNT
+    return LARGE_PREFILL_TILE_COUNT
+
+
+def _tile_count_override() -> tuple[int | None, bool]:
+    raw = os.getenv(TILE_COUNT_OVERRIDE_ENV)
+    if raw is None or raw == "":
+        return None, True
+    if raw not in {
+        str(SMALL_PREFILL_TILE_COUNT),
+        str(LARGE_PREFILL_TILE_COUNT),
+    }:
+        return None, False
+    return int(raw), True
+
+
+def _positive_env_int(name: str, default: int) -> tuple[int, bool]:
+    raw = os.getenv(name)
+    if raw is None:
+        return default, True
+    try:
+        value = int(raw)
+    except ValueError:
+        return default, False
+    if value <= 0:
+        return default, False
+    return value, True
+
+
+def mixtral_tp4_routing_exact_chain_enabled() -> bool:
+    _, valid_minimum = _positive_env_int(MIN_TOKENS_ENV, DEFAULT_MIN_TOKENS)
+    _, valid_override = _tile_count_override()
+    _, valid_metadata_mode = routing_metadata_mode_for_runtime()
+    return (os.getenv(ENABLE_ENV) == "1" and valid_minimum
+            and valid_override and valid_metadata_mode)
+
+
+def mixtral_tp4_routing_exact_chain_min_tokens() -> int:
+    value, _ = _positive_env_int(MIN_TOKENS_ENV, DEFAULT_MIN_TOKENS)
+    return value
+
+
+def _trace_limit() -> int:
+    raw = os.getenv(TRACE_LIMIT_ENV)
+    if raw is None:
+        return DEFAULT_TRACE_LIMIT
+    try:
+        return max(0, int(raw))
+    except ValueError:
+        return 0
+
+
+def build_static_contract(
+    vllm_config: Any,
+    *,
+    use_aclgraph: bool,
+    dynamic_eplb: bool,
+    in_dtype: torch.dtype,
+) -> dict[str, Any]:
+    model_config = getattr(vllm_config, "model_config", None)
+    parallel_config = getattr(vllm_config, "parallel_config", None)
+    hf_config = getattr(model_config, "hf_config", None)
+    metadata_mode, _ = routing_metadata_mode_for_runtime()
+    return {
+        "model_type": getattr(hf_config, "model_type", None),
+        "quant_method": "AscendW8A8DynamicFusedMoEMethod",
+        "tp_size": getattr(parallel_config, "tensor_parallel_size", None),
+        "dp_size": getattr(parallel_config, "data_parallel_size", None),
+        "pp_size": getattr(parallel_config, "pipeline_parallel_size", None),
+        "ep_enabled": getattr(parallel_config, "enable_expert_parallel", None),
+        "enforce_eager": bool(getattr(model_config, "enforce_eager", False)),
+        "use_aclgraph": bool(use_aclgraph),
+        "dynamic_eplb": bool(dynamic_eplb),
+        "model_dtype": str(in_dtype),
+        "tile_policy": {
+            "small_prefill_min_tokens": DEFAULT_MIN_TOKENS,
+            "small_prefill_max_tokens_exclusive": SMALL_PREFILL_MAX_TOKENS,
+            "small_prefill_tile_count": SMALL_PREFILL_TILE_COUNT,
+            "large_prefill_tile_count": LARGE_PREFILL_TILE_COUNT,
+        },
+        "pending_depth": pending_depth_for_runtime(),
+        "routing_operator": "torch_npu.npu_moe_init_routing_quant",
+        **routing_metadata_contract(metadata_mode),
+    }
+
+
+def static_contract_valid(contract: Mapping[str, Any]) -> bool:
+    metadata_mode, valid_metadata_mode = routing_metadata_mode_for_runtime()
+    if not valid_metadata_mode:
+        return False
+    expected = {
+        "model_type": "mixtral",
+        "quant_method": "AscendW8A8DynamicFusedMoEMethod",
+        "tp_size": 4,
+        "dp_size": 1,
+        "pp_size": 1,
+        "ep_enabled": False,
+        "enforce_eager": True,
+        "use_aclgraph": False,
+        "dynamic_eplb": False,
+        "model_dtype": str(torch.bfloat16),
+        "tile_policy": {
+            "small_prefill_min_tokens": DEFAULT_MIN_TOKENS,
+            "small_prefill_max_tokens_exclusive": SMALL_PREFILL_MAX_TOKENS,
+            "small_prefill_tile_count": SMALL_PREFILL_TILE_COUNT,
+            "large_prefill_tile_count": LARGE_PREFILL_TILE_COUNT,
+        },
+        "pending_depth": pending_depth_for_runtime(),
+        "routing_operator": "torch_npu.npu_moe_init_routing_quant",
+        **routing_metadata_contract(metadata_mode),
+    }
+    return dict(contract) == expected
+
+
+def _shape(value: Any) -> tuple[int, ...] | None:
+    shape = getattr(value, "shape", None)
+    return tuple(shape) if shape is not None else None
+
+
+def _is_compiling() -> bool:
+    try:
+        return bool(torch.compiler.is_compiling()
+                    or torch._dynamo.is_compiling())
+    except Exception:
+        return True
+
+
+def supported_moe_comm_method(moe_comm_method: Any) -> bool:
+    comm_type = type(moe_comm_method)
+    return bool(comm_type.__module__ == "vllm_ascend.ops.moe.moe_comm_method"
+                and comm_type.__name__
+                in {"AllGatherCommImpl", "NaiveMulticastCommImpl"})
+
+
+def runtime_contract_rejection(
+    *,
+    statically_enabled: bool,
+    static_contract: Mapping[str, Any],
+    min_tokens: int,
+    forward_context: Any,
+    moe_comm_method: Any,
+    layer: Any,
+    hidden_states: Any,
+    topk_weights: Any,
+    topk_ids: Any,
+    top_k: int,
+    global_num_experts: int,
+    expert_map: Any,
+    pertoken_scale: Any,
+    enable_force_load_balance: bool,
+    dynamic_eplb: bool,
+    shared_experts: Any,
+    quantized_x_for_share: Any,
+    dynamic_scale_for_share: Any,
+    log2phy: Any,
+    global_redundant_expert_num: int,
+) -> str | None:
+    if not statically_enabled:
+        return "opt_in_or_static_contract_disabled"
+    _, valid_override = _tile_count_override()
+    if not valid_override:
+        return "tile_count_override_invalid"
+    _, valid_metadata_mode = routing_metadata_mode_for_runtime()
+    if not valid_metadata_mode:
+        return "routing_metadata_mode_invalid"
+    if not static_contract_valid(static_contract):
+        return "static_contract_invalid"
+    if forward_context is None:
+        return "forward_context_missing"
+    if getattr(forward_context, "with_prefill", None) is not True:
+        return "not_prefill"
+    if (getattr(forward_context, "in_profile_run", None) is not False
+            and os.getenv(ALLOW_OPTIMIZED_PROFILE_ENV) != "1"):
+        return "profile_or_unknown_phase"
+    if getattr(forward_context, "sp_enabled", None) is not False:
+        return "sequence_parallel_not_supported"
+    if _is_compiling():
+        return "compilation_active"
+    if not supported_moe_comm_method(moe_comm_method):
+        return "allgather_or_naive_multicast_comm_required"
+    if not torch.distributed.is_initialized():
+        return "distributed_not_initialized"
+    if getattr(layer, "reduce_results", None) is not True:
+        return "outer_tp_reduce_not_owned"
+    if top_k != TOP_K or global_num_experts != NUM_EXPERTS:
+        return "mixtral_topology_mismatch"
+    if expert_map is not None or log2phy is not None:
+        return "expert_parallel_mapping_present"
+    if global_redundant_expert_num != 0 or dynamic_eplb:
+        return "expert_load_balancing_enabled"
+    if enable_force_load_balance:
+        return "force_load_balance_enabled"
+    if pertoken_scale is not None:
+        return "prequantized_input_not_supported"
+    if any(value is not None for value in (
+            shared_experts,
+            quantized_x_for_share,
+            dynamic_scale_for_share,
+    )):
+        return "shared_expert_path_not_supported"
+    if getattr(hidden_states, "ndim", None) != 2:
+        return "hidden_rank_mismatch"
+    hidden_shape = _shape(hidden_states)
+    if hidden_shape is None or hidden_shape[1] != HIDDEN_SIZE:
+        return "hidden_shape_mismatch"
+    num_tokens = hidden_shape[0]
+    tile_count = tile_count_for_tokens(num_tokens)
+    if num_tokens < min_tokens or num_tokens % tile_count != 0:
+        return "not_large_divisible_prefill"
+    if getattr(hidden_states, "dtype", None) != torch.bfloat16:
+        return "hidden_dtype_mismatch"
+    if _shape(topk_weights) != (num_tokens, TOP_K):
+        return "topk_weight_shape_mismatch"
+    if getattr(topk_weights, "dtype", None) != torch.bfloat16:
+        return "topk_weight_dtype_mismatch"
+    if _shape(topk_ids) != (num_tokens, TOP_K):
+        return "topk_id_shape_mismatch"
+    if getattr(topk_ids, "dtype", None) != torch.int32:
+        return "topk_id_dtype_mismatch"
+
+    expected_parameters = (
+        ("w13_weight", (NUM_EXPERTS, HIDDEN_SIZE, W13_OUTPUT_SIZE),
+         torch.int8),
+        (
+            "w2_weight",
+            (NUM_EXPERTS, LOCAL_INTERMEDIATE_SIZE, HIDDEN_SIZE),
+            torch.int8,
+        ),
+        (
+            "w13_weight_scale",
+            (NUM_EXPERTS, W13_OUTPUT_SIZE),
+            torch.bfloat16,
+        ),
+        ("w2_weight_scale", (NUM_EXPERTS, HIDDEN_SIZE), torch.bfloat16),
+    )
+    for name, expected_shape, expected_dtype in expected_parameters:
+        value = getattr(layer, name, None)
+        if _shape(value) != expected_shape:
+            return f"{name}_shape_mismatch"
+        if getattr(value, "dtype", None) != expected_dtype:
+            return f"{name}_dtype_mismatch"
+    tp_group = getattr(getattr(layer, "moe_config", None), "tp_group", None)
+    if getattr(tp_group, "device_group", None) is None:
+        return "tp_device_group_missing"
+    if getattr(tp_group, "world_size", None) != 4:
+        return "tp_group_size_mismatch"
+    return None
+
+
+def _validate_routing_outputs(
+    outputs: Any, *, tile_tokens: int, hidden_size: int, metadata_mode: int
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor,
+           torch.Tensor, int]:
+    if not isinstance(outputs, tuple) or len(outputs) != 5:
+        raise MixtralTP4RoutingExactChainContractError(
+            "routing-quant must return five outputs")
+    routed, row_idx, expert_metadata, before_capacity, dynamic_scale = outputs
+    if before_capacity is not None:
+        raise MixtralTP4RoutingExactChainContractError(
+            "routing-quant output[3] must be None when its flag is false")
+    expected_rows = tile_tokens * TOP_K
+    contracts = (
+        ("routed", routed, (expected_rows, hidden_size), torch.int8),
+        ("row_idx", row_idx, (expected_rows, ), torch.int32),
+        (
+            "expert_metadata",
+            expert_metadata,
+            (NUM_EXPERTS, ),
+            torch.int32,
+        ),
+        (
+            "dynamic_scale",
+            dynamic_scale,
+            (expected_rows, ),
+            torch.float32,
+        ),
+    )
+    for name, value, expected_shape, expected_dtype in contracts:
+        if _shape(value) != expected_shape or value.dtype != expected_dtype:
+            raise MixtralTP4RoutingExactChainContractError(
+                f"{name} ABI mismatch: shape={_shape(value)}, dtype={value.dtype}"
+            )
+    metadata_i64 = expert_metadata.to(torch.int64)
+    if metadata_mode == 1:
+        group_boundaries = metadata_i64
+        gmm2_group_list = metadata_i64
+        gmm2_group_list_type = 0
+    elif metadata_mode == 2:
+        group_boundaries = metadata_i64.cumsum(dim=0)
+        gmm2_group_list = metadata_i64
+        gmm2_group_list_type = 1
+    else:
+        raise MixtralTP4RoutingExactChainContractError(
+            f"unsupported routing metadata mode: {metadata_mode}")
+    return (routed, row_idx, group_boundaries, gmm2_group_list,
+            dynamic_scale, gmm2_group_list_type)
+
+
+def _run_expert_tile(
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    *,
+    w13_weight: torch.Tensor,
+    w13_scale: torch.Tensor,
+    w2_weight: torch.Tensor,
+    w2_scale: torch.Tensor,
+    observer: Optional[Callable[[dict[str, Any]], None]] = None,
+    tile_index: int,
+    metadata_mode: int,
+) -> torch.Tensor:
+    outputs = torch_npu.npu_moe_init_routing_quant(
+        hidden_states,
+        expert_idx=topk_ids,
+        active_num=0,
+        expert_capacity=0,
+        expert_num=NUM_EXPERTS,
+        drop_pad_mode=0,
+        expert_tokens_num_mode=metadata_mode,
+        expert_tokens_before_capacity_flag=False,
+        quant_mode=1,
+    )
+    (routed, expanded_row_idx, group_boundaries, gmm2_group_list,
+     dynamic_scale, gmm2_group_list_type) = (
+        _validate_routing_outputs(
+            outputs,
+            tile_tokens=int(hidden_states.shape[0]),
+            hidden_size=int(hidden_states.shape[1]),
+            metadata_mode=metadata_mode,
+        ))
+    if observer:
+        observer({"event": "routing_quant", "tile": tile_index})
+
+    activated, activated_scale, _ = (torch_npu.npu_grouped_matmul_swiglu_quant(
+        x=routed,
+        weight=w13_weight,
+        bias=None,
+        group_list=group_boundaries,
+        weight_scale=w13_scale,
+        x_scale=dynamic_scale,
+    ))
+    if observer:
+        observer({"event": "gmm1_swiglu_requant", "tile": tile_index})
+    down = torch_npu.npu_grouped_matmul(
+        x=[activated],
+        weight=[w2_weight],
+        scale=[w2_scale],
+        bias=None,
+        per_token_scale=[activated_scale],
+        split_item=2,
+        group_list_type=gmm2_group_list_type,
+        group_type=0,
+        group_list=gmm2_group_list,
+        output_dtype=torch.bfloat16,
+    )[0]
+    if observer:
+        observer({"event": "gmm2", "tile": tile_index})
+    combined = torch_npu.npu_moe_token_unpermute(
+        permuted_tokens=down,
+        sorted_indices=expanded_row_idx,
+        probs=topk_weights,
+    )
+    if observer:
+        observer({"event": "token_unpermute", "tile": tile_index})
+    return combined
+
+
+def _drain_pending_work(
+    pending: list[tuple[int, torch.Tensor, Any]],
+    *,
+    reason: str,
+    observer: Optional[Callable[[dict[str, Any]], None]],
+) -> None:
+    first_error: BaseException | None = None
+    while pending:
+        waited_tile, stable_slice, work = pending.pop(0)
+        try:
+            work.wait()
+        except BaseException as error:
+            if first_error is None:
+                first_error = error
+        del stable_slice
+        if observer:
+            try:
+                observer({
+                    "event": "wait",
+                    "tile": waited_tile,
+                    "reason": reason
+                })
+            except BaseException as error:
+                if first_error is None:
+                    first_error = error
+    if first_error is not None:
+        raise first_error
+
+
+def run_mixtral_tp4_routing_exact_chain(
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    *,
+    layer: Any,
+    observer: Optional[Callable[[dict[str, Any]], None]] = None,
+) -> MixtralTP4RoutingExactChainResult:
+    _, valid_override = _tile_count_override()
+    if not valid_override:
+        raise MixtralTP4RoutingExactChainContractError(
+            "tile-count override must be 4 or 8 when set"
+        )
+    metadata_mode, valid_metadata_mode = routing_metadata_mode_for_runtime()
+    if not valid_metadata_mode:
+        raise MixtralTP4RoutingExactChainContractError(
+            "routing metadata mode must be 1 or 2 when set")
+    metadata_contract = routing_metadata_contract(metadata_mode)
+    num_tokens = int(hidden_states.shape[0])
+    tile_count = tile_count_for_tokens(num_tokens)
+    if num_tokens <= 0 or num_tokens % tile_count:
+        raise MixtralTP4RoutingExactChainContractError(
+            "carrier requires a positive token count divisible by its selected tile count")
+    output = torch.empty_like(hidden_states)
+    pending: list[tuple[int, torch.Tensor, Any]] = []
+    pending_depth = pending_depth_for_runtime()
+    tp_group = layer.moe_config.tp_group.device_group
+    try:
+        for tile_index in range(tile_count):
+            token_start = tile_index * num_tokens // tile_count
+            token_end = (tile_index + 1) * num_tokens // tile_count
+            combined = _run_expert_tile(
+                hidden_states[token_start:token_end],
+                topk_ids[token_start:token_end],
+                topk_weights[token_start:token_end],
+                w13_weight=layer.w13_weight,
+                w13_scale=layer.w13_weight_scale,
+                w2_weight=layer.w2_weight,
+                w2_scale=layer.w2_weight_scale,
+                observer=observer,
+                tile_index=tile_index,
+                metadata_mode=metadata_mode,
+            )
+            stable_slice = output[token_start:token_end]
+            stable_slice.copy_(combined)
+            if observer:
+                observer({
+                    "event": "copy_to_stable_output",
+                    "tile": tile_index
+                })
+
+            if len(pending) == pending_depth:
+                waited_tile, previous_slice, previous_work = pending.pop(0)
+                previous_work.wait()
+                if observer:
+                    observer({
+                        "event": "wait",
+                        "tile": waited_tile,
+                        "reason": "before_pending_window_reuse",
+                    })
+                del previous_slice
+
+            work = torch.distributed.all_reduce(
+                stable_slice,
+                op=torch.distributed.ReduceOp.SUM,
+                group=tp_group,
+                async_op=True,
+            )
+            if work is None or not callable(getattr(work, "wait", None)):
+                raise MixtralTP4RoutingExactChainContractError(
+                    "async TP SUM did not return a Work handle")
+            pending.append((tile_index, stable_slice, work))
+            if observer:
+                observer({
+                    "event":
+                    "collective_launch",
+                    "tile":
+                    tile_index,
+                    "shape": [token_end - token_start,
+                              int(output.shape[1])],
+                    "op":
+                    "SUM",
+                    "async":
+                    True,
+                })
+
+        _drain_pending_work(
+            pending,
+            reason="final_drain",
+            observer=observer,
+        )
+    except BaseException:
+        try:
+            _drain_pending_work(
+                pending,
+                reason="exception_drain",
+                observer=observer,
+            )
+        except BaseException:
+            # Every handle was waited; preserve the error that aborted the
+            # carrier instead of replacing it with a cleanup wait failure.
+            pass
+        raise
+    layer_id_value = getattr(layer, "moe_instance_id", None)
+    layer_id = layer_id_value if isinstance(layer_id_value, int) else None
+    return MixtralTP4RoutingExactChainResult(
+        hidden_states=output,
+        num_tokens=num_tokens,
+        layer_id=layer_id,
+        layer_prefix=str(getattr(layer, "prefix", "")),
+        tile_count=tile_count,
+        collective_count=tile_count,
+        pending_depth=pending_depth,
+        routing_metadata_mode=metadata_mode,
+        expert_metadata_semantics=metadata_contract[
+            "expert_metadata_semantics"],
+        gmm2_group_list_type=metadata_contract["gmm2_group_list_type"],
+    )
+
+
+def _trace_rank() -> int:
+    try:
+        if torch.distributed.is_initialized():
+            return int(torch.distributed.get_rank())
+    except Exception:
+        pass
+    try:
+        return int(os.getenv("RANK", "0"))
+    except ValueError:
+        return 0
+
+
+def _tp_rank() -> int:
+    try:
+        if torch.distributed.is_initialized():
+            return int(torch.distributed.get_rank())
+    except Exception:
+        pass
+    try:
+        return int(os.getenv("LOCAL_RANK", os.getenv("RANK", "0")))
+    except ValueError:
+        return 0
+
+
+def _trace_rank_path(base_path: str, rank: int) -> Path:
+    expanded = os.path.expanduser(base_path)
+    if "{rank}" in expanded:
+        return Path(expanded.format(rank=rank))
+    path = Path(expanded)
+    if path.suffix == ".jsonl":
+        return path.with_name(f"{path.stem}.rank{rank}.jsonl")
+    return Path(f"{path}.rank{rank}.jsonl")
+
+
+def record_completed_marker(
+    result: MixtralTP4RoutingExactChainResult,
+    *,
+    outer_finalize_skipped: bool,
+) -> None:
+    """Write static/shape-only proof after the outer finalizer skipped TP SUM."""
+    if not outer_finalize_skipped:
+        return
+
+    global _HIT_LOGGED
+    with _TRACE_LOCK:
+        should_log = not _HIT_LOGGED
+        _HIT_LOGGED = True
+    if should_log:
+        logger.info(
+            "Mixtral W8A8 TP4 MoE pipeline hit: tp_rank=%d tokens=%d "
+            "tiles=%d pending=%d",
+            _tp_rank(),
+            result.num_tokens,
+            result.tile_count,
+            result.pending_depth,
+        )
+
+    base_path = os.getenv(TRACE_PATH_ENV, "").strip()
+    limit = _trace_limit()
+    if not base_path or limit <= 0:
+        return
+    try:
+        rank = _trace_rank()
+        path = _trace_rank_path(base_path, rank)
+        with _TRACE_LOCK:
+            event_index = _TRACE_COUNTS.get(path, 0) + 1
+            if event_index > limit:
+                return
+            handle = _TRACE_HANDLES.get(path)
+            if handle is None:
+                path.parent.mkdir(parents=True, exist_ok=True)
