new file mode 100644
index 0000000000000000000000000000000000000000..1b323f47e67e1c203d5f50ea84f5e77a51811ad5
--- /dev/null
+++ b/vllm_ascend/stage_timing.py
@@ -0,0 +1,175 @@
+#
+# Copyright (c) 2026 MindPipe contributors.
+#
+"""Lightweight opt-in timing helpers for local VLM throughput diagnosis.
+
+The helpers are intentionally inert unless MINDPIPE_STAGE_TIMING_PATH is set.
+When enabled, each timed scope writes one JSONL row. NPU synchronization is on
+by default because wall-clock timing without it is misleading for async ops.
+"""
+
+from __future__ import annotations
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+import json
+import os
+from pathlib import Path
+import threading
+import time
+from typing import Any, Iterator
+
+
+_PATH = os.environ.get("MINDPIPE_STAGE_TIMING_PATH")
+_ENABLED = bool(_PATH)
+_TRACE_ENABLED = os.environ.get("MINDPIPE_PROFILE_TRACE", "0").lower() in {
+    "1",
+    "true",
+    "yes",
+    "on",
+}
+_TRACE_DOMAIN = "mindpipe.a2_moe"
+_MSTX_MESSAGE_MAX_BYTES = 127
+_SYNC = os.environ.get("MINDPIPE_STAGE_TIMING_SYNC", "1").lower() not in {
+    "0",
+    "false",
+    "no",
+    "off",
+}
+_LOCK = threading.Lock()
+_HANDLE = None
+_PROFILE_RUN = ContextVar("mindpipe_stage_timing_profile_run", default=False)
+
+
+def enabled() -> bool:
+    return _ENABLED
+
+
+def trace_enabled() -> bool:
+    return _TRACE_ENABLED
+
+
+@contextmanager
+def profile_scope() -> Iterator[None]:
+    """Mark events emitted by engine startup profiling."""
+    token = _PROFILE_RUN.set(True)
+    try:
+        yield
+    finally:
+        _PROFILE_RUN.reset(token)
+
+
+def _sync_device() -> None:
+    if not _SYNC:
+        return
+    try:
+        import torch
+
+        if hasattr(torch, "npu") and torch.npu.is_available():
+            torch.npu.synchronize()
+    except Exception:
+        return
+
+
+def _jsonable(value: Any) -> Any:
+    if value is None or isinstance(value, (str, int, float, bool)):
+        return value
+    if isinstance(value, (list, tuple)):
+        return [_jsonable(item) for item in value]
+    if isinstance(value, dict):
+        return {str(key): _jsonable(item) for key, item in value.items()}
+    shape = getattr(value, "shape", None)
+    dtype = getattr(value, "dtype", None)
+    device = getattr(value, "device", None)
+    if shape is not None:
+        return {
+            "shape": list(shape),
+            "dtype": str(dtype) if dtype is not None else None,
+            "device": str(device) if device is not None else None,
+        }
+    return str(value)
+
+
+def _write_event(row: dict[str, Any]) -> None:
+    if not _PATH:
+        return
+    global _HANDLE
+    with _LOCK:
+        if _HANDLE is None:
+            path = Path(_PATH)
+            path.parent.mkdir(parents=True, exist_ok=True)
+            _HANDLE = path.open("a", encoding="utf-8", buffering=1)
+        _HANDLE.write(json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
+        _HANDLE.flush()
+
+
+def _compact_trace_message(stage: str, metadata: dict[str, Any]) -> str:
+    """Build a device marker below CANN's 128-byte MSTX message limit."""
+    phase = str(metadata.get("phase", ""))[:1]
+    message = "|".join((
+        f"s={stage}",
+        f"r={metadata.get('rank', '')}",
+        f"i={metadata.get('step', '')}",
+        f"p={phase}",
+        f"a={metadata.get('actual_tokens', '')}",
+        f"n={metadata.get('input_tokens', '')}",
+        f"d={metadata.get('padded_tokens', '')}",
+    ))
+    return message.encode("ascii", errors="replace")[
+        :_MSTX_MESSAGE_MAX_BYTES].decode("ascii")
+
+
+@contextmanager
+def record(stage: str, **metadata: Any) -> Iterator[None]:
+    if not _ENABLED:
+        yield
+        return
+
+    metadata.setdefault("profile_run", _PROFILE_RUN.get())
+    _sync_device()
+    started = time.perf_counter()
+    try:
+        yield
+    finally:
+        _sync_device()
+        elapsed = time.perf_counter() - started
+        _write_event({
+            "kind": "stage_timing",
+            "stage": stage,
+            "elapsed_s": elapsed,
+            "pid": os.getpid(),
+            "time": time.time(),
+            "metadata": _jsonable(metadata),
+        })
+
+
+@contextmanager
+def trace(stage: str, **metadata: Any) -> Iterator[None]:
+    """Emit an opt-in profiler range without synchronizing the NPU stream."""
+    if not _TRACE_ENABLED:
+        yield
+        return
+
+    import torch
+    from torch_npu.npu.mstx import mstx
+
+    message = json.dumps(
+        {
+            "stage": stage,
+            "metadata": _jsonable(metadata),
+        },
+        ensure_ascii=True,
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+    with torch.profiler.record_function(message):
+        range_id = mstx.range_start(
+            _compact_trace_message(stage, metadata),
+            stream=torch.npu.current_stream(),
+            domain=_TRACE_DOMAIN,
+        )
+        try:
+            yield
+        finally:
+            if isinstance(range_id, int) and range_id > 0:
+                mstx.range_end(range_id, domain=_TRACE_DOMAIN)
