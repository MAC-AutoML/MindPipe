+            "top_k": int(topk_ids.shape[-1]),
+            "num_experts": _QWEN3_MOE_EXPERT_COUNT,
+            "force_load_balance": bool(enable_force_load_balance),
+            "out_of_range_count": out_of_range,
+            "expert_counts": [int(value) for value in counts.tolist()],
+        }
+        with _EXPERT_LOAD_LOCK:
+            handle = _EXPERT_LOAD_HANDLES.get(path)
+            if handle is None:
+                path.parent.mkdir(parents=True, exist_ok=True)
+                handle = path.open("a", encoding="utf-8", buffering=1)
+                _EXPERT_LOAD_HANDLES[path] = handle
+            handle.write(
+                json.dumps(row, ensure_ascii=False, sort_keys=True) + "\n")
+    except Exception:
+        # Diagnostics must never make model execution fail.
+        return
